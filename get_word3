def get_video_comments(video_url, max_comments=10):
    # 주어진 비디오 URL에 대해 댓글 가져오기
    response = requests.get(video_url)
    soup = BeautifulSoup(response.text, 'html.parser')

    # 댓글 가져오기 (이 부분은 동적으로 로드되는 데이터를 처리하지 않음)
    comments_divs = soup.find_all('yt-formatted-string', {'id': 'content-text'}, limit=max_comments)
    comments = [comment.text for comment in comments_divs]
    
    # 공백으로 분할하여 리스트에 추가
    words = []
    for comment in comments:
        words.extend(comment.split())
    return words

